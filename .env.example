# Contentful
# Space settings → API keys: use "Content delivery API - access token" and/or "Content preview API - access token"
# Required content types: project (with category, featuredVideo), pageTextBlock, projectCategory
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
# Content Delivery API – access token (public, for published content)
CONTENTFUL_DELIVERY_TOKEN=
# Content Preview API – access token (draft/unpublished content; optional, for preview mode)
CONTENTFUL_PREVIEW_TOKEN=

# Optional: public site URL (for SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=https://3colorstudio.com

# Optional: social links (used in footer when set)
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_BEHANCE=
NEXT_PUBLIC_LINKEDIN=
